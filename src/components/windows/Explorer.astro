---
import Window from '../Window.astro';
import { pixelSvg } from '../../lib/pixel';
import { winId, byTier, type Project } from '../../lib/projects';

interface Props { projects: Project[]; }
const { projects } = Astro.props;
const tiers = byTier(projects);
const groups = [
  { key: 'headline', label: 'Pinned', note: 'The six I would show you first', items: tiers.headline },
  { key: 'supporting', label: 'Also built', note: 'Real projects with real constraints', items: tiers.supporting },
  { key: 'brief', label: 'Small things', note: 'Sketches, tools, and one honest failure', items: tiers.brief },
];
const fmt = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Window id="projects" title="Projects" icon="folderOpen" kind="app" w={860} h={560} x={150} y={36}>
  <Fragment slot="toolbar">
    <span class="ex-addr-label">Address</span>
    <span class="field ex-addr"><Fragment set:html={pixelSvg('folderOpen', 16)} />C:\CUPER\PROJECTS</span>
  </Fragment>

  <div class="ex">
    <aside class="ex-side" aria-live="polite">
      <div class="ex-side-hero">
        <Fragment set:html={pixelSvg('folderOpen', 32)} />
        <h2>Projects</h2>
      </div>
      <div class="ex-side-body" id="ex-detail">
        <p class="ex-hint">Select an item to see its description. Double-click to open it.</p>
        <p class="ex-hint">{projects.length} projects. The first six are the ones pinned on my GitHub.</p>
      </div>
    </aside>

    <div class="ex-files" role="listbox" aria-label="Projects" aria-orientation="horizontal" tabindex="-1">
      {groups.map(g => (
        <section class="ex-group" aria-label={g.label}>
          <h3 class="ex-group-h"><span>{g.label}</span><small>{g.note}</small></h3>
          <div class="ex-grid">
            {g.items.map(p => (
              <button
                class="ex-item"
                type="button"
                role="option"
                aria-selected="false"
                data-item={winId(p.data.slug)}
                data-title={p.data.title}
                data-one={p.data.oneLiner}
                data-tech={p.data.tech.join(' · ')}
                data-updated={fmt(p.data.updated)}
                data-file={p.data.file}
              >
                <span class="ex-icon"><Fragment set:html={pixelSvg(p.data.icon, 32)} /></span>
                <span class="ex-name">{p.data.title}</span>
              </button>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <Fragment slot="status">
    <span class="fit" id="ex-count">{projects.length} object(s)</span>
    <span id="ex-status">Double-click an icon to open it.</span>
  </Fragment>
</Window>

<style>
  .ex-addr-label { font: 400 var(--t-11)/1 var(--f-sys); color: var(--c-ink-mute); padding: 0 4px; letter-spacing: var(--track-caps); text-transform: uppercase; }
  .ex-addr { flex: 1; display: flex; align-items: center; gap: 6px; font: 400 var(--t-11)/1 var(--f-sys); color: var(--c-acc); padding: 4px 6px; min-width: 0; overflow: hidden; white-space: nowrap; }
  .ex {
    display: grid;
    grid-template-columns: 228px 1fr;
    height: 100%;
    background: var(--c-paper);
    box-shadow: var(--bevel-sunken);
    padding: 2px;
    min-height: 0;
  }
  .ex-side { overflow: auto; background: linear-gradient(180deg, #0c1222, var(--c-paper) 40%); box-shadow: inset -1px 0 var(--c-rule); }
  .ex-side-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: 22px 14px 12px;
    background: linear-gradient(120deg, var(--c-title-a), var(--c-title-b) 70%, rgba(12, 106, 134, 0));
    overflow: hidden;
  }
  .ex-side-hero::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 3px); }
  .ex-side-hero h2 { position: relative; font: 400 var(--t-22)/1 var(--f-sys); color: #fff; }
  .ex-side-body { padding: 14px 14px 18px; font: 400 var(--t-13)/1.55 var(--f-read); color: var(--c-ink-soft); }
  .ex-side-body :global(h3) { font: 400 var(--t-13)/1.25 var(--f-sys); color: var(--c-ink); margin: 2px 0 8px; }
  .ex-side-body :global(.one) { color: var(--c-ink); margin-bottom: 12px; text-wrap: pretty; }
  .ex-side-body :global(.row) { font: 400 var(--t-11)/1.5 var(--f-sys); color: var(--c-ink-mute); margin-bottom: 4px; }
  .ex-side-body :global(.row b) { color: var(--c-ink-soft); font-weight: 400; letter-spacing: var(--track-caps); text-transform: uppercase; margin-right: 4px; }
  .ex-side-body :global(.btn) { margin-top: 12px; }
  .ex-hint { color: var(--c-ink-mute); margin-bottom: 8px; }

  .ex-files { overflow: auto; padding: 10px 12px 16px; outline: none; }
  .ex-group + .ex-group { margin-top: 18px; }
  .ex-group-h {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 0 2px 6px;
    margin-bottom: 8px;
    box-shadow: inset 0 -1px var(--c-rule);
    font: 400 var(--t-11)/1 var(--f-sys);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--c-acc);
  }
  .ex-group-h small { font: 400 var(--t-11)/1 var(--f-sys); letter-spacing: 0; text-transform: none; color: var(--c-ink-mute); }
  .ex-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 6px 2px; }
  .ex-item { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 6px 2px 4px; background: none; border: 0; color: var(--c-ink); }
  .ex-icon { position: relative; display: block; filter: drop-shadow(0 2px 0 rgba(0, 0, 0, 0.6)); }
  .ex-name { font: 400 var(--t-11)/1.3 var(--f-sys); text-align: center; padding: 1px 4px; max-width: 100%; overflow-wrap: anywhere; }
  .ex-item[aria-selected="true"] .ex-name { background: rgba(94, 242, 255, 0.18); color: #fff; outline: 1px dotted var(--c-acc); }
  .ex-item[aria-selected="true"] .ex-icon::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-conic-gradient(rgba(94, 242, 255, 0.45) 0 25%, transparent 0 50%) 0 0 / 2px 2px;
    mix-blend-mode: screen;
  }
  .ex-item:focus-visible { outline: none; }
  .ex-item:focus-visible .ex-name { outline: 1px dotted var(--c-acc); }
  @media (hover: hover) { .ex-item:hover .ex-name { color: var(--c-acc); } }
  @media (max-width: 720px) { .ex { grid-template-columns: 1fr; } .ex-side { display: none; } }
</style>
