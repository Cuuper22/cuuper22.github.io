---
import Window from '../Window.astro';
---

<Window id="dos" title="MS-DOS Prompt" icon="dos" kind="app" w={680} h={420} x={260} y={120} label="MS-DOS Prompt: a command line for this site">
  <div class="dos crt" data-capture-keys>
    <pre class="dos-out" id="dos-out" role="log" aria-live="polite">CúperOS [Version 22.5.2026]
(C) Copyright Cúper Anas 2004-2026.

Type HELP for commands. Try DIR, or START ERDOS.

</pre>
    <div class="dos-line">
      <label for="dos-in" id="dos-prompt">C:\CUPER&gt;</label>
      <input id="dos-in" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go" aria-describedby="dos-prompt" />
    </div>
  </div>
</Window>

<style>
  .dos {
    height: 100%;
    overflow: auto;
    padding: 8px 12px 12px;
    background:
      radial-gradient(120% 100% at 50% 50%, transparent 60%, rgba(0, 0, 0, 0.6) 100%),
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 3px),
      #03060c;
    color: #bdeff5;
    font: 400 var(--t-15)/1.45 var(--f-sys);
    box-shadow: var(--bevel-sunken);
    text-shadow: 0 0 6px rgba(94, 242, 255, 0.35);
    cursor: text;
  }
  .dos-out { margin: 0; font: inherit; white-space: pre-wrap; word-break: break-word; }
  .dos-out :global(.hi) { color: #fff; }
  .dos-out :global(.dim) { color: #5d7a85; text-shadow: none; }
  .dos-out :global(.dos-link) { all: unset; display: inline; white-space: pre; cursor: pointer; }
  .dos-out :global(.dos-link:hover), .dos-out :global(.dos-link:focus-visible) { background: var(--c-acc); color: #03060c; text-shadow: none; }
  .dos-line { display: flex; align-items: baseline; }
  .dos-line label { white-space: pre; color: var(--c-acc); }
  .dos-line input { flex: 1; min-width: 0; background: transparent; border: 0; outline: none; color: #fff; font: inherit; caret-color: var(--c-acc); padding: 0; }
  @media (max-width: 720px) { .dos, .dos-line input { font-size: 16px; } }
</style>
