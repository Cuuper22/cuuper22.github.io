<div class="demo toaru" data-demo="toaru">
  <div class="monitor">
    <div class="bezel">
      <div class="v86-screen" id="toaru-screen" tabindex="0" data-capture-keys aria-label="ToaruOS-Arnold running in an emulator. Click to use the mouse; Esc releases it.">
        <div class="v86-text"></div>
        <canvas></canvas>
        <div class="toaru-overlay" data-overlay>
          <p class="t-line" data-status>Press Power to boot ToaruOS-Arnold.</p>
          <div class="t-bar"><span data-bar></span></div>
          <button class="btn" type="button" data-power-on>Power on</button>
        </div>
      </div>
    </div>
    <div class="chin">
      <span class="brand">CúperVision <b>1024</b></span>
      <span class="led" data-led></span>
    </div>
  </div>
  <div class="toaru-bar">
    <button class="btn btn-sm" type="button" data-cad disabled>Ctrl+Alt+Del</button>
    <button class="btn btn-sm" type="button" data-power disabled>Power off</button>
    <span class="toaru-hint" data-hint>2.8 MB download. Keyboard and mouse work; networking doesn't (v86 has no E1000).</span>
  </div>
</div>

