<div class="demo erdos" data-demo="erdos">
  <div class="er-lock">
    <span class="er-lock-k">locked</span>
    <code>theorem one_plus_one : 1 + 1 = 2</code>
    <span class="er-hash" title="SHA-256 of the whitespace-normalized statement, computed in your browser">sha256 <b data-lock-hash>…</b></span>
  </div>

  <ol class="er-stages" aria-label="Pipeline stages">
    <li data-stage="gen"><span>A</span>Prover</li>
    <li data-stage="lock"><span>B</span>Integrity</li>
    <li data-stage="build"><span>C</span>lake build</li>
    <li data-stage="critic"><span>D</span>Critic</li>
  </ol>

  <div class="er-grid">
    <div class="er-panel">
      <p class="er-cap">Attempt <b data-attempt>1</b> of 10 <span class="er-verdict" data-verdict></span></p>
      <pre class="er-code" data-code></pre>
      <p class="er-cand" data-cand-hash></p>
    </div>
    <div class="er-panel">
      <p class="er-cap">What the Prover is told next</p>
      <p class="er-feedback" data-feedback>Nothing yet.</p>
      <p class="er-cap">events.jsonl</p>
      <pre class="er-log" data-log aria-live="polite"></pre>
    </div>
  </div>

  <div class="er-bar">
    <button class="btn btn-sm" type="button" data-replay>Replay</button>
    <button class="btn btn-sm" type="button" data-step>Step</button>
    <span class="er-note">A reenactment built from the repo's test fixtures. The stages, statuses, and feedback rules are the real ones.</span>
  </div>
</div>

<style>
  .erdos { padding: 14px 16px; background: var(--c-paper-2); box-shadow: inset 0 -1px var(--c-rule); }
  .er-lock { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 8px 12px; background: var(--c-paper); box-shadow: var(--bevel-sunken), inset 3px 0 0 -1px var(--c-acc); font: 400 var(--t-11)/1.3 var(--f-sys); }
  .er-lock-k { color: #03060c; background: var(--c-acc); padding: 2px 6px 1px; letter-spacing: var(--track-caps); text-transform: uppercase; }
  .er-lock code { font: 400 var(--t-13)/1.3 var(--f-sys); color: var(--c-ink); }
  .er-hash { margin-left: auto; color: var(--c-ink-mute); }
  .er-hash b { color: var(--c-acc); font-weight: 400; }

  .er-stages { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin: 12px 0; list-style: none; padding: 0; }
  .er-stages li {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 8px;
    background: var(--c-face);
    box-shadow: var(--bevel-raised);
    font: 400 var(--t-11)/1 var(--f-sys);
    color: var(--c-ink-soft);
    transition: background 140ms, color 140ms, box-shadow 140ms;
  }
  .er-stages li span { display: grid; place-items: center; width: 18px; height: 18px; background: var(--c-paper); box-shadow: var(--bevel-thin-in); color: var(--c-ink-mute); }
  .er-stages li[data-s="run"] { color: var(--c-amber); box-shadow: var(--bevel-raised), inset 0 -2px var(--c-amber); }
  .er-stages li[data-s="pass"] { color: var(--c-ok); box-shadow: var(--bevel-raised), inset 0 -2px var(--c-ok); }
  .er-stages li[data-s="fail"] { color: var(--c-bad); box-shadow: var(--bevel-raised), inset 0 -2px var(--c-bad); background: #22111a; }
  .er-stages li[data-s="skip"] { color: var(--c-ink-faint); }

  .er-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 12px; }
  .er-panel { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .er-cap { font: 400 var(--t-11)/1 var(--f-sys); letter-spacing: var(--track-caps); text-transform: uppercase; color: var(--c-ink-mute); display: flex; gap: 8px; align-items: center; min-height: 18px; }
  .er-cap b { color: var(--c-ink); font-weight: 400; }
  .er-verdict { font: 400 var(--t-11)/1 var(--f-sys); padding: 3px 6px 2px; text-transform: none; letter-spacing: 0; }
  .er-verdict.fail { background: var(--c-bad); color: #1a0209; }
  .er-verdict.ok { background: var(--c-ok); color: #021a0d; box-shadow: 0 0 14px rgba(95, 245, 166, 0.5); }
  .er-code, .er-log { margin: 0; padding: 10px 12px; font: 400 var(--t-11)/1.65 var(--f-sys); box-shadow: var(--bevel-sunken); overflow: auto; white-space: pre; }
  .er-code { background: var(--c-paper); color: var(--c-ink); min-height: 88px; }
  .er-code :global(mark) { background: rgba(255, 93, 122, 0.2); color: var(--c-bad); box-shadow: inset 0 -1px var(--c-bad); padding: 0 2px; }
  .er-cand { font: 400 var(--t-11)/1.3 var(--f-sys); color: var(--c-ink-mute); min-height: 1.3em; }
  .er-cand :global(.bad) { color: var(--c-bad); }
  .er-cand :global(.good) { color: var(--c-ok); }
  .er-feedback { background: var(--c-paper); box-shadow: var(--bevel-sunken); padding: 10px 12px; font: 400 var(--t-13)/1.5 var(--f-read); color: var(--c-ink-soft); min-height: 58px; }
  .er-feedback :global(b) { color: var(--c-ink); font-weight: 600; }
  .er-feedback :global(code) { font: 400 var(--t-11)/1.4 var(--f-sys); color: var(--c-acc); }
  .er-feedback :global(span) { color: var(--c-ink-mute) !important; }
  .er-log { background: #03060c; color: #7d8aa8; height: 118px; }
  .er-log :global(.ev) { color: #7d8aa8; }
  .er-log :global(.bad) { color: var(--c-bad); }
  .er-log :global(.good) { color: var(--c-ok); }
  .er-bar { display: flex; align-items: center; gap: 6px; margin-top: 12px; flex-wrap: wrap; }
  .er-note { font: 400 var(--t-11)/1.45 var(--f-sys); color: var(--c-ink-mute); flex: 1; min-width: 220px; }
  @media (max-width: 720px) { .er-grid { grid-template-columns: 1fr; } .er-stages { grid-template-columns: repeat(2, 1fr); } .er-hash { margin-left: 0; } }
</style>
