---
const program = `IT'S SHOWTIME
HEY CHRISTMAS TREE t
YOU SET US UP 3
STICK AROUND t
TALK TO THE HAND t
GET TO THE CHOPPER t
HERE IS MY INVITATION t
GET DOWN 1
ENOUGH TALK
CHILL
EVERYBODY CHILL
TALK TO THE HAND "liftoff"
LET'S PARTY
YOU HAVE BEEN TERMINATED`;

const keywords: [string, string][] = [
  ['I NEED YOUR MEMORY', 'malloc'],
  ["YOU'RE LUGGAGE", 'free'],
  ['EVERYBODY CHILL', 'cli (interrupts off)'],
  ["LET'S PARTY", 'sti (interrupts on)'],
  ['SLEEP NOW', 'hlt'],
  ['TALK TO THE PORT', 'outb'],
  ['SPEAK TO THE MACHINE', 'inline asm block'],
  ['POINT YOUR GUN AT', 'pointer type'],
  ['SHOW ME WHAT YOU GOT', 'dereference'],
  ['THIS IS MY DISGUISE', 'union'],
  ['THIS IS A TINY WARRIOR', 'u8'],
  ['THIS COULD CHANGE ANYTIME', 'volatile'],
  ['THERE IS NO ONE', 'NULL'],
  ["YOU'RE NOT BIG ENOUGH", '<'],
  ['GET OUT', 'break'],
  ['LET OFF SOME STEAM BENNET', '> (from the original)'],
];
---

<div class="demo arnoldc" data-demo="arnoldc">
  <div class="ac-panes">
    <label class="ac-pane">
      <span class="ac-cap">countdown.arnoldc <em>(edit me)</em></span>
      <textarea class="ac-src" spellcheck="false" autocapitalize="characters" data-src>{program}</textarea>
    </label>
    <div class="ac-pane">
      <span class="ac-cap">arnoldc -asm → countdown.asm</span>
      <pre class="ac-asm" data-asm aria-live="polite"></pre>
    </div>
  </div>
  <div class="ac-run">
    <span class="ac-cap">./countdown</span>
    <pre class="ac-out" data-out></pre>
  </div>
  <details class="ac-keys">
    <summary>Some of the ~90 keywords ArnoldC-Native adds</summary>
    <table>
      <tbody>
        {keywords.map(([k, v]) => <tr><td><code>{k}</code></td><td>{v}</td></tr>)}
      </tbody>
    </table>
  </details>
</div>

<style>
  .arnoldc { padding: 16px; background: var(--c-paper-2); box-shadow: inset 0 -1px var(--c-rule); }
  .ac-panes { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .ac-pane { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .ac-cap { font: 400 var(--t-11)/1 var(--f-sys); letter-spacing: var(--track-caps); text-transform: uppercase; color: var(--c-ink-mute); }
  .ac-cap em { font-style: normal; color: var(--c-amber); }
  .ac-src, .ac-asm, .ac-out {
    font: 400 var(--t-11)/1.6 var(--f-sys);
    box-shadow: var(--bevel-sunken);
    border: 0;
    padding: 10px 12px;
    margin: 0;
    height: 236px;
    overflow: auto;
    white-space: pre;
    tab-size: 4;
  }
  .ac-src { background: #070a13; color: var(--c-ink); resize: none; text-transform: uppercase; caret-color: var(--c-acc); }
  .ac-asm { background: #050c1f; color: #cfd8f5; }
  .ac-asm :global(.c) { color: #5f7bb0; }
  .ac-asm :global(.l) { color: var(--c-acc); }
  .ac-asm :global(.e) { color: var(--c-bad); }
  .ac-run { margin-top: 10px; display: flex; flex-direction: column; gap: 6px; }
  .ac-out { height: auto; min-height: 58px; max-height: 110px; background: #03060c; color: var(--c-ok); font-size: var(--t-13); text-shadow: 0 0 8px rgba(95, 245, 166, 0.45); }
  .ac-keys { margin-top: 12px; }
  .ac-keys summary { cursor: pointer; padding: 2px 0; font: 400 var(--t-11)/1.4 var(--f-sys); color: var(--c-ink-soft); letter-spacing: var(--track-caps); text-transform: uppercase; }
  .ac-keys summary:hover { color: var(--c-acc); }
  .ac-keys table { margin-top: 8px; border-collapse: collapse; width: 100%; background: var(--c-paper); box-shadow: var(--bevel-sunken); }
  .ac-keys td { padding: 5px 12px; font: 400 var(--t-13)/1.4 var(--f-read); color: var(--c-ink-soft); box-shadow: inset 0 -1px var(--c-rule); }
  .ac-keys td code { font: 400 var(--t-11)/1.4 var(--f-sys); color: var(--c-amber); }
  @media (max-width: 720px) { .ac-panes { grid-template-columns: 1fr; } .ac-src, .ac-asm { height: 190px; } }
</style>
