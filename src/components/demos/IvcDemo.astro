---
// Counts from research/data/claim_ledger/claims.json at HEAD (checked 2026-09-28).
const rows: [string, number, string][] = [
  ['Translations', 0, 'A reading of a whole inscription.'],
  ['Phonetic values', 0, 'A sound assigned to a sign.'],
  ['Sign meanings', 0, 'A meaning assigned to a sign.'],
  ['Language identification', 0, 'Which language family the script writes.'],
  ['External anchors', 0, 'A bilingual, a name, anything tying the script to a known text.'],
  ['Structural findings', 1, 'A regularity in how signs combine. Says nothing about meaning.'],
];
---

<div class="demo ivc" data-demo="ivc">
  <div class="iv-sheet" role="table" aria-label="Claim ledger: accepted claims by class">
    <div class="iv-row iv-h" role="row">
      <span role="columnheader">Claim class</span>
      <span role="columnheader">Accepted</span>
      <span role="columnheader">What it would mean</span>
    </div>
    {rows.map(([k, n, d]) => (
      <div class:list={['iv-row', { yes: n > 0 }]} role="row" data-count={n}>
        <span role="cell">{k}</span>
        <span role="cell" class="iv-n">{n}</span>
        <span role="cell" class="iv-d">{d}</span>
      </div>
    ))}
  </div>

  <div class="iv-bottom">
    <div class="iv-finding">
      <p class="iv-k">The one survivor</p>
      <div class="iv-signs" aria-label="Sign 002, then the string 861, 533, 717">
        <span class="sg ctx">002</span><span class="gap">…</span><span class="sg">861</span><span class="sg">533</span><span class="sg">717</span>
      </div>
      <p class="iv-note">Recurs on seals M-376 and M-391. Tested on 4,135 strict rows. A pattern, not a meaning.</p>
    </div>
    <div class="iv-stats">
      <p><b>13</b> candidates proposed</p>
      <p><b>11</b> retracted</p>
      <p><b>2</b> not accepted</p>
      <p class="iv-q">Quarantined branches kept for autopsy, never citable.</p>
    </div>
  </div>
</div>

<style>
  .ivc { padding: 14px 16px; background: var(--c-paper-2); box-shadow: inset 0 -1px var(--c-rule); }
  .iv-sheet { background: var(--c-paper); box-shadow: var(--bevel-sunken); padding: 2px; }
  .iv-row { display: grid; grid-template-columns: 200px 80px 1fr; }
  .iv-row > span { padding: 6px 10px; box-shadow: inset -1px -1px var(--c-rule); font: 400 var(--t-13)/1.35 var(--f-read); color: var(--c-ink-soft); }
  .iv-h > span { background: var(--c-face); box-shadow: var(--bevel-thin-out); font: 400 var(--t-11)/1.3 var(--f-sys); letter-spacing: var(--track-caps); text-transform: uppercase; color: var(--c-ink-mute); }
  .iv-n { text-align: right; font: 400 var(--t-13)/1.35 var(--f-sys) !important; font-variant-numeric: tabular-nums; }
  .iv-d { color: var(--c-ink-mute) !important; }
  .iv-row.yes > span { background: rgba(255, 181, 71, 0.08); color: var(--c-ink); }
  .iv-row.yes .iv-n { color: var(--c-amber); text-shadow: 0 0 10px rgba(255, 181, 71, 0.5); }
  .iv-row:not(.iv-h):not(.yes) .iv-n { color: var(--c-ink-faint); }
  .iv-bottom { display: grid; grid-template-columns: 1fr auto; gap: 16px; margin-top: 14px; align-items: start; }
  .iv-k { font: 400 var(--t-11)/1 var(--f-sys); letter-spacing: var(--track-caps); text-transform: uppercase; color: var(--c-ink-mute); margin-bottom: 8px; }
  .iv-signs { display: flex; align-items: center; gap: 5px; }
  /* Steatite: the one warm material on the machine */
  .sg {
    display: grid;
    place-items: center;
    min-width: 48px;
    height: 48px;
    padding: 0 6px;
    background: linear-gradient(160deg, #e6dcc4, #c9b994);
    color: #3b3020;
    box-shadow: inset 2px 2px #f7efdc, inset -2px -2px #9c8b66, 0 6px 16px -6px rgba(0, 0, 0, 0.7);
    font: 400 var(--t-13)/1 var(--f-sys);
  }
  .sg.ctx { opacity: 0.45; }
  .gap { color: var(--c-ink-mute); padding: 0 2px; }
  .iv-note { font: 400 var(--t-13)/1.5 var(--f-read); color: var(--c-ink-soft); margin-top: 10px; max-width: 48ch; }
  .iv-stats { font: 400 var(--t-13)/1.7 var(--f-read); color: var(--c-ink-soft); padding: 10px 14px; background: var(--c-paper); box-shadow: var(--bevel-sunken); min-width: 200px; }
  .iv-stats b { font: 400 var(--t-13)/1 var(--f-sys); color: var(--c-ink); display: inline-block; min-width: 2em; text-align: right; margin-right: 6px; }
  .iv-q { font: 400 var(--t-11)/1.45 var(--f-sys); color: var(--c-ink-mute); margin-top: 6px; max-width: 26ch; }
  @media (max-width: 720px) {
    .iv-row { grid-template-columns: 1fr 64px; }
    .iv-d { display: none; }
    .iv-bottom { grid-template-columns: 1fr; }
  }
</style>
