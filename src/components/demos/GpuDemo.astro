---
// Real variable names and edges from gpu_stack's exported registry cone.
// Descriptions are my one-line paraphrases.
const chain: [string, string][] = [
  ['physics.speed_of_light', 'c. One of only twelve true constants in the model.'],
  ['physical.link.signal_speed', 'How fast a signal actually moves in the cable, a fraction of c.'],
  ['physical.link.time_of_flight', 'Cable length divided by signal speed.'],
  ['link.scaleout.latency', 'End-to-end latency across the scale-out network.'],
  ['link.scaleout.alpha', 'The fixed per-message cost (α) in the α–β comms model.'],
  ['training.dp.alpha', 'That α, as seen by data-parallel collectives.'],
  ['training.t_comm_dp', 'Time spent in data-parallel communication each step.'],
  ['training.t_exposed_comm', 'The part of that communication compute can\'t hide.'],
  ['training.t_step_nominal', 'Step time before real-world overheads.'],
  ['training.t_step', 'Time per training step.'],
  ['training.wallclock_nominal', 'Ideal run length.'],
  ['training.wallclock', 'Actual run length.'],
  ['econ.run.hw_cost', 'What the hardware costs for that long.'],
  ['econ.run.total_cost', 'Hardware plus power.'],
  ['econ.cost.per_token', 'The number everyone asks about.'],
];
const side: { from: string; to: string; note: string }[] = [
  { from: 'econ.run.power_cost', to: 'econ.run.total_cost', note: 'the electricity bill' },
  { from: 'training.total_tokens', to: 'econ.cost.per_token', note: 'root input: the denominator' },
];
const scope = (id: string) => id.split('.')[0];
---

<div class="demo gpu" data-demo="gpu">
  <div class="gp-head">
    <p>One real path through the graph. Click any variable to see what it depends on and what it feeds.</p>
    <button class="btn btn-sm" type="button" data-trace>Trace c → $/token</button>
  </div>
  <div class="gp-body">
    <ol class="gp-chain">
      {chain.map(([id, desc], i) => (
        <li>
          <button type="button" class="gp-node" data-node={id} data-i={i} data-scope={scope(id)} data-desc={desc}>
            <span class="gp-scope">{scope(id)}</span><code>{id}</code>
          </button>
          {side.filter(s => s.to === id).map(s => (
            <span class="gp-side" data-from={s.from} title={s.note}>+ <code>{s.from}</code></span>
          ))}
        </li>
      ))}
    </ol>
    <aside class="gp-info" aria-live="polite">
      <p class="gp-info-k">Selected</p>
      <p class="gp-info-id" data-info-id>econ.cost.per_token</p>
      <p class="gp-info-d" data-info-desc>The number everyone asks about.</p>
      <p class="gp-info-k">Upstream on this path</p>
      <p class="gp-info-n" data-info-up>14 variables, back to the speed of light</p>
      <p class="gp-info-k">In the full export</p>
      <p class="gp-info-n">700 nodes · 999 edges · 289 root inputs · 12 constants</p>
      <a class="btn btn-sm" href="https://cuuper22.github.io/gpu_stack-/observatory.html" target="_blank" rel="noopener">Open the observatory ↗</a>
    </aside>
  </div>
</div>

<style>
  .gpu { padding: 12px 14px; background: #0c1a24; color: #cfe3ef; border-bottom: 1px solid #06101a; font-family: var(--f-ui); }
  .gp-head { display: flex; align-items: center; gap: 10px; justify-content: space-between; flex-wrap: wrap; margin-bottom: 10px; }
  .gp-head p { font: 400 13px/1.4 var(--f-read); color: #a9c4d4; }
  .gp-body { display: grid; grid-template-columns: 1fr 220px; gap: 14px; }
  .gp-chain { list-style: none; padding: 0; margin: 0; position: relative; }
  .gp-chain li { position: relative; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding-left: 16px; }
  .gp-chain li + li { margin-top: 3px; }
  .gp-chain li::before { content: ''; position: absolute; left: 5px; top: -3px; bottom: -3px; width: 2px; background: #274456; }
  .gp-chain li:first-child::before { top: 50%; }
  .gp-chain li:last-child::before { bottom: 50%; }
  .gp-chain li::after { content: ''; position: absolute; left: 2px; top: 50%; width: 8px; height: 8px; margin-top: -4px; background: #0c1a24; box-shadow: inset 0 0 0 2px #3d6a85; }
  .gp-node {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 3px 8px 3px 4px;
    background: #12293a;
    border: 0;
    color: #d8ebf6;
    box-shadow: inset 0 0 0 1px #274456;
    text-align: left;
    transition: background 120ms, box-shadow 120ms, color 120ms;
  }
  .gp-node code { font: 400 12.5px/1.3 var(--f-mono); }
  .gp-scope { font: 400 10.5px/1 var(--f-ui); padding: 2px 5px; min-width: 64px; text-align: center; letter-spacing: 0.3px; color: #0c1a24; background: var(--sc, #7fb2cc); }
  .gp-node[data-scope="physics"], .gp-node[data-scope="physical"] { --sc: #ff9f6b; }
  .gp-node[data-scope="link"] { --sc: #ffd166; }
  .gp-node[data-scope="training"] { --sc: #7fdcff; }
  .gp-node[data-scope="econ"] { --sc: #8ef0a2; }
  .gp-node:hover { background: #183650; }
  .gp-node.up { box-shadow: inset 0 0 0 1px #ffd166; }
  .gp-node.down { box-shadow: inset 0 0 0 1px #8ef0a2; }
  .gp-node.sel { background: #fff; color: #0c1a24; box-shadow: inset 0 0 0 2px #ffd166; }
  .gp-node.lit { background: #ffd166; color: #0c1a24; }
  li:has(.gp-node.up)::after, li:has(.gp-node.sel)::after, li:has(.gp-node.lit)::after { background: #ffd166; box-shadow: none; }
  .gp-side { font: 400 11.5px/1 var(--f-read); color: #86a6b8; }
  .gp-side code { font: 400 11.5px/1 var(--f-mono); color: #b7d2e2; }
  .gp-info { background: #12293a; box-shadow: inset 0 0 0 1px #274456; padding: 10px 12px; align-self: start; position: sticky; top: 0; }
  .gp-info-k { font: 400 10.5px/1 var(--f-ui); letter-spacing: 0.6px; text-transform: uppercase; color: #6f93a8; margin-top: 10px; }
  .gp-info-k:first-child { margin-top: 0; }
  .gp-info-id { font: 600 13px/1.3 var(--f-mono); color: #fff; margin-top: 4px; overflow-wrap: anywhere; }
  .gp-info-d, .gp-info-n { font: 400 12.5px/1.4 var(--f-read); color: #cfe3ef; margin-top: 4px; }
  .gp-info .btn { margin-top: 12px; }
  @media (max-width: 720px) { .gp-body { grid-template-columns: 1fr; } .gp-info { position: static; } }
</style>
