---
import { pixelSvg } from '../lib/pixel';
---

<!--
  Decide before first paint whether to boot, so the desktop never flashes underneath.
  Boot once per browser session; never for reduced motion, deep links, or return visits.
-->
<script is:inline>
  (function () {
    try {
      var q = new URLSearchParams(location.search);
      var deep = q.has('open') || location.hash.length > 1;
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var seen = sessionStorage.getItem('cuperos.booted');
      if (q.has('boot') || (!deep && !reduce && !seen)) document.documentElement.dataset.boot = '1';
    } catch (e) { /* storage blocked: skip the boot, show the desktop */ }
  })();
</script>

<div class="boot" id="boot" aria-hidden="true">
  <div class="post" id="post">
    <div class="post-mark"><Fragment set:html={pixelSvg('shades', 64)} /><span>An Arnold<br />Energy Ally</span></div>
    <pre id="post-text"></pre>
    <p class="post-foot">Press <b>ESC</b> or click to skip · <b>DEL</b> to enter SETUP</p>
  </div>
  <div class="splash" id="splash" hidden>
    <div class="splash-floor"></div>
    <div class="splash-center">
      <p class="splash-eyebrow">Cúper Anas presents</p>
      <div class="splash-logo">Cúper<b>OS</b></div>
      <div class="splash-rule"><span></span></div>
      <p class="splash-tag">I build things to understand how they work.</p>
    </div>
  </div>
</div>

<style is:global>
  .boot { display: none; }
  html[data-boot] .boot {
    display: block;
    position: fixed;
    inset: 0;
    z-index: var(--z-boot);
    background: #000;
    color: #b8b8b8;
    font: 400 var(--t-13)/1.55 var(--f-sys);
    cursor: none;
  }
  html[data-boot] .taskbar, html[data-boot] .desktop > * { visibility: hidden; }
  .boot.is-leaving { animation: boot-out 380ms cubic-bezier(0.6, 0, 0.8, 0.2) forwards; }
  @keyframes boot-out { 60% { opacity: 1; filter: brightness(1.8); transform: scaleY(0.012); } to { opacity: 0; visibility: hidden; transform: scaleY(0.002) scaleX(0.2); } }

  .post { position: absolute; inset: 0; padding: clamp(18px, 4vw, 44px); }
  .post-mark { position: absolute; top: clamp(18px, 4vw, 44px); right: clamp(18px, 4vw, 44px); display: flex; align-items: center; gap: 12px; color: #5ff5a6; text-align: right; font-size: var(--t-11); line-height: 1.2; letter-spacing: 0.06em; text-transform: uppercase; }
  .post-mark svg { width: 64px; height: 64px; }
  #post-text { font: inherit; white-space: pre-wrap; margin: 0; max-width: 78ch; }
  #post-text .hi { color: #fff; }
  #post-text .ok { color: #5ff5a6; }
  #post-text .dim { color: #666; }
  .post-foot { position: absolute; left: clamp(18px, 4vw, 44px); bottom: clamp(18px, 4vw, 44px); color: #7a7a7a; font-size: var(--t-11); }
  .post-foot b { color: #fff; font-weight: 400; }

  .splash {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(70% 45% at 50% 100%, rgba(0, 128, 128, 0.4), transparent 70%),
      linear-gradient(180deg, #02040a, #060b18 60%, #07182a);
    color: var(--c-ink);
    animation: splash-in 420ms var(--ease) both;
  }
  @keyframes splash-in { from { opacity: 0; filter: brightness(2); } }
  .splash-floor {
    position: absolute;
    left: -50%; right: -50%; bottom: 0;
    height: 48%;
    perspective: 420px;
    perspective-origin: 50% 0%;
    mask-image: linear-gradient(180deg, transparent, #000 45%);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 45%);
  }
  .splash-floor::before {
    content: '';
    position: absolute;
    inset: 0 0 -60% 0;
    transform-origin: 50% 0%;
    transform: rotateX(64deg);
    background-image: linear-gradient(rgba(94, 242, 255, 0.35) 1px, transparent 1px), linear-gradient(90deg, rgba(94, 242, 255, 0.35) 1px, transparent 1px);
    background-size: 64px 64px;
    animation: grid-drift 1.2s linear infinite;
  }
  .splash-center { position: relative; display: flex; flex-direction: column; align-items: center; gap: 14px; margin-bottom: 8vh; }
  .splash-eyebrow { font: 400 var(--t-11)/1 var(--f-sys); letter-spacing: 0.4em; text-transform: uppercase; color: var(--c-ink-mute); }
  .splash-logo {
    font: 400 clamp(55px, 11vw, 132px)/0.9 var(--f-sys);
    letter-spacing: -0.03em;
    color: #fff;
    text-shadow: 0 0 30px rgba(94, 242, 255, 0.35);
    animation: logo-in 520ms steps(6, end) both;
  }
  .splash-logo b { font-weight: 400; color: var(--c-acc); text-shadow: 0 0 24px rgba(94, 242, 255, 0.8), 0 0 60px rgba(94, 242, 255, 0.4); }
  @keyframes logo-in { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  .splash-rule { width: min(360px, 70vw); height: 2px; background: rgba(94, 242, 255, 0.15); overflow: hidden; }
  .splash-rule span { display: block; width: 30%; height: 100%; background: var(--c-acc); box-shadow: 0 0 12px var(--c-acc); animation: scan 700ms var(--ease) infinite; }
  @keyframes scan { from { transform: translateX(-110%); } to { transform: translateX(360%); } }
  .splash-tag { font: 400 var(--t-13)/1 var(--f-sys); color: var(--c-ink-soft); letter-spacing: 0.02em; }
</style>
