---
import { pixelSvg } from '../lib/pixel';
---

<!--
  Decide before first paint whether to boot, so the desktop never flashes underneath.
  Boot once per browser session; never for reduced motion, deep links, or return visits.
-->
<script is:inline>
  (function () {
    try {
      var q = new URLSearchParams(location.search);
      var deep = q.has('open') || location.hash.length > 1;
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var seen = sessionStorage.getItem('cuperos.booted');
      if (q.has('boot') || (!deep && !reduce && !seen)) document.documentElement.dataset.boot = '1';
    } catch (e) { /* storage blocked: skip the boot, show the desktop */ }
  })();
</script>

<div class="boot" id="boot" aria-hidden="true">
  <div class="post" id="post">
    <div class="post-mark"><Fragment set:html={pixelSvg('shades', 64)} /><span>An Arnold<br />Energy Ally</span></div>
    <pre id="post-text"></pre>
    <p class="post-foot">Press <b>ESC</b> or click to skip · <b>DEL</b> to enter SETUP</p>
  </div>
  <div class="splash" id="splash" hidden>
    <div class="splash-center">
      <div class="splash-logo"><span>Cúper</span><b>OS</b></div>
      <div class="splash-ver">22.5</div>
    </div>
    <p class="splash-tag">I build things to understand how they work.</p>
    <div class="splash-band"></div>
  </div>
</div>

<style is:global>
  .boot { display: none; }
  html[data-boot] .boot {
    display: block;
    position: fixed;
    inset: 0;
    z-index: var(--z-boot);
    background: #000;
    color: #bdbdbd;
    font: 400 clamp(17px, 2.2vw, 22px)/1.18 var(--f-dos);
    cursor: none;
  }
  html[data-boot] .taskbar, html[data-boot] .desktop > * { visibility: hidden; }
  .boot.is-leaving { animation: boot-out 220ms steps(4, end) forwards; }
  @keyframes boot-out { to { opacity: 0; visibility: hidden; } }

  .post { position: absolute; inset: 0; padding: clamp(16px, 4vw, 40px); }
  .post[hidden] { display: none; }
  .post-mark { position: absolute; top: clamp(16px, 4vw, 40px); right: clamp(16px, 4vw, 40px); display: flex; align-items: center; gap: 10px; color: #55ff55; text-align: right; font-size: 0.8em; line-height: 1.05; }
  .post-mark svg { width: 64px; height: 64px; }
  #post-text { font: inherit; white-space: pre-wrap; margin: 0; max-width: 72ch; }
  #post-text .hi { color: #fff; }
  #post-text .ok { color: #55ff55; }
  #post-text .dim { color: #7a7a7a; }
  .post-foot { position: absolute; left: clamp(16px, 4vw, 40px); bottom: clamp(16px, 4vw, 40px); color: #8a8a8a; }
  .post-foot b { color: #fff; font-weight: 400; }

  .splash {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 50% at 50% 45%, #0b3f8f 0%, #06275a 55%, #020c1e 100%);
    color: #fff;
  }
  .splash[hidden] { display: none; }
  .splash-center { display: flex; align-items: flex-start; gap: 10px; }
  .splash-logo { font: 700 clamp(56px, 11vw, 124px)/0.9 var(--f-ui); letter-spacing: 1px; text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.35); }
  .splash-logo b { color: #ffd84a; font-weight: 700; }
  .splash-ver { font: 400 clamp(18px, 2.6vw, 28px)/1 var(--f-ui); color: #9ec4ff; margin-top: 0.4em; }
  .splash-tag { position: absolute; left: 0; right: 0; bottom: 58px; text-align: center; font: 400 15px/1 var(--f-ui); color: #9ec4ff; letter-spacing: 0.5px; }
  .splash-band {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 22px;
    background: linear-gradient(90deg, #0000a8, #00a8a8, #a800a8, #ffd84a, #0000a8, #00a8a8, #a800a8, #ffd84a, #0000a8);
    background-size: 50% 100%;
    animation: band 1.1s linear infinite;
  }
  @keyframes band { to { background-position: 100% 0; } }
</style>
