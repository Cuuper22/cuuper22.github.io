<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>BSOD - CúperOS</title>
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#0000AA" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;600;700&family=IBM+Plex+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #0000AA;
      color: white;
      font-family: 'IBM Plex Mono', 'Courier New', monospace;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
      padding-bottom: max(40px, env(safe-area-inset-bottom));
    }

    .bsod { max-width: 660px; width: 100%; }

    .bsod-os {
      font-family: 'Pixelify Sans', monospace;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 1px;
      margin-bottom: 20px;
    }

    .bsod-title {
      background: #AAAAAA;
      color: #0000AA;
      display: inline-block;
      padding: 2px 10px;
      font-family: 'Pixelify Sans', monospace;
      font-weight: 700;
      font-size: 16px;
      margin-bottom: 22px;
    }

    .bsod-text {
      font-size: 14px;
      line-height: 1.85;
      white-space: pre-wrap;
    }

    .bsod-actions {
      margin-top: 26px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .bsod-btn {
      font-family: 'Pixelify Sans', monospace;
      font-size: 14px;
      color: #0000AA;
      background: #AAAAAA;
      border: 2px outset #c8c8c8;
      padding: 10px 16px;
      text-decoration: none;
      cursor: pointer;
      transition: background 110ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .bsod-btn:hover { background: #c4c4c4; }
    .bsod-btn:active { border-style: inset; transform: translate(1px, 1px); }
    .bsod-btn:focus-visible { outline: 2px dotted #fff; outline-offset: 2px; }

    .bsod-cursor {
      display: inline-block;
      width: 9px;
      height: 16px;
      background: white;
      vertical-align: text-bottom;
      animation: blink 1s step-end infinite;
    }

    @keyframes blink { 50% { opacity: 0; } }

    @media (prefers-reduced-motion: reduce) {
      .bsod-cursor { animation: none; }
      .bsod-btn { transition: none; }
    }
  </style>
</head>
<body>
  <div class="bsod" role="alertdialog" aria-labelledby="bsod-h">
    <div class="bsod-os">CúperOS</div>
    <div class="bsod-title" id="bsod-h">PORTFOLIO_OS</div>
    <div class="bsod-text">A fatal exception 0x404 has occurred at 0028:C0011E36.

The page you requested does not exist or has been
terminated by the system administrator.

HASTA LA VISTA, BABY. That page is not coming back.

*  Press Enter to return to the Desktop.
*  Press Ctrl+K to search for what you are looking for.

System halted <span class="bsod-cursor" aria-hidden="true"></span></div>
    <div class="bsod-actions">
      <a href="/" class="bsod-btn">Return to Desktop</a>
      <a href="/?cmd=open" class="bsod-btn">Search (Ctrl+K)</a>
    </div>
  </div>

  <script>
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        window.location.href = '/?cmd=open';
      } else if (e.key === 'Enter' || e.key === 'Escape') {
        window.location.href = '/';
      }
    });
  </script>
</body>
</html>
