---
import Base from '../layouts/Base.astro';
---

<Base title="Fatal exception 0x404 · CúperOS" description="This page does not exist.">
  <Fragment slot="head"><meta name="robots" content="noindex" /></Fragment>
  <main class="bsod" role="alertdialog" aria-labelledby="bsod-h" aria-describedby="bsod-t">
    <p class="bsod-h" id="bsod-h">CúperOS</p>
    <div class="bsod-t" id="bsod-t">
      <p>A fatal exception 0x404 has occurred at 0028:C0011E36 in VxD PAGES(01) + <span id="bsod-path">/</span>.
The page you asked for does not exist, or it has been terminated by the system administrator.</p>
      <p>HASTA LA VISTA, BABY. That page is not coming back.</p>
      <p>*  Press any key to return to the Desktop.
*  Press D for the MS-DOS Prompt, or Q for the Quick read.</p>
      <p>Press any key to continue <span class="cursor" aria-hidden="true"></span></p>
    </div>
    <nav class="bsod-actions" aria-label="Where to go">
      <a href="/">Desktop</a>
      <a href="/?open=dos">MS-DOS Prompt</a>
      <a href="/read/">Quick read</a>
    </nav>
  </main>

  <script>
    const path = document.getElementById('bsod-path');
    if (path) path.textContent = location.pathname.toUpperCase();
    document.addEventListener('keydown', e => {
      if (e.metaKey || e.ctrlKey || e.altKey || e.key === 'Tab' || e.key === 'Shift') return;
      const k = e.key.toLowerCase();
      location.href = k === 'd' ? '/?open=dos' : k === 'q' ? '/read/' : '/';
    });
  </script>
</Base>

<style>
  body { background: #0000aa; }
  .bsod {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 32px 20px;
    color: #fff;
    font: 400 clamp(19px, 2.3vw, 24px)/1.25 var(--f-dos);
  }
  .bsod-h { background: #aaaaaa; color: #0000aa; padding: 0 10px; margin-bottom: 28px; }
  .bsod-t { max-width: 64ch; }
  .bsod-t p { white-space: pre-wrap; }
  .bsod-t p + p { margin-top: 1.2em; }
  .cursor { display: inline-block; width: 0.55em; height: 1em; background: #fff; vertical-align: text-bottom; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .bsod-actions { display: flex; gap: 14px; margin-top: 36px; flex-wrap: wrap; justify-content: center; }
  .bsod-actions a { color: #0000aa; background: #aaaaaa; padding: 2px 12px; text-decoration: none; }
  .bsod-actions a:hover, .bsod-actions a:focus-visible { background: #fff; outline: none; }
</style>
