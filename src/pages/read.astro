---
import Base from '../layouts/Base.astro';
import { pixelSvg } from '../lib/pixel';
import { getProjects, byTier, projectLinks, summary } from '../lib/projects';

const projects = await getProjects();
const { headline, supporting, brief } = byTier(projects);
const month = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Base title="Cúper Anas · Quick read" description="Everything on one plain page: who Cúper Anas is, the six pinned projects, and everything else he has built.">
  <div class="qr">
    <header class="qr-bar raised">
      <a class="qr-home" href="/"><Fragment set:html={pixelSvg('computer', 16)} />CúperOS</a>
      <span class="qr-crumb">Quick read</span>
      <span class="qr-spacer"></span>
      <button class="btn btn-sm" type="button" onclick="window.print()">Print</button>
      <a class="btn btn-sm" href="/">Back to the desktop</a>
    </header>

    <main class="qr-paper">
      <header class="qr-intro">
        <p class="qr-kicker">Quick read · everything on one page</p>
        <h1>Cúper Anas</h1>
        <p class="qr-lede">I build systems that have to answer to reality: agents that stop before they fabricate, tools that keep humans in the loop, and experiments where the edge cases are the point. Currently in Orange County, trying to get back to the Bay.</p>
        <ul class="qr-contact">
          <li><Fragment set:html={pixelSvg('mail', 16)} /><a href="mailto:cuuper225@gmail.com">cuuper225@gmail.com</a></li>
          <li><Fragment set:html={pixelSvg('github', 16)} /><a href="https://github.com/Cuuper22">github.com/Cuuper22</a></li>
          <li><Fragment set:html={pixelSvg('link', 16)} /><a href="https://linkedin.com/in/yousefanas">linkedin.com/in/yousefanas</a></li>
        </ul>
      </header>

      <section class="qr-section" aria-labelledby="h-pinned">
        <h2 id="h-pinned">Pinned</h2>
        {headline.map(p => (
          <article class="qr-proj">
            <div class="qr-proj-h">
              <Fragment set:html={pixelSvg(p.data.icon, 32)} />
              <div>
                <h3><a href={`/projects/${p.data.slug}/`}>{p.data.title}</a></h3>
                <p class="qr-one">{p.data.oneLiner}</p>
              </div>
            </div>
            <p class="qr-sum">{summary(p)}</p>
            <p class="qr-links">
              <span class="qr-tech">{p.data.tech.join(' · ')}</span>
              {projectLinks(p).map(l => <a href={l.url}>{l.label}</a>)}
              <a href={`/?open=${p.data.slug}`}>Open on the desktop</a>
            </p>
          </article>
        ))}
      </section>

      <section class="qr-section" aria-labelledby="h-also">
        <h2 id="h-also">Also built</h2>
        <ul class="qr-list">
          {supporting.map(p => (
            <li>
              <Fragment set:html={pixelSvg(p.data.icon, 16)} />
              <div>
                <a class="qr-li-t" href={`/projects/${p.data.slug}/`}>{p.data.title}</a>
                <span class="qr-li-d"> {p.data.oneLiner}</span>
                <span class="qr-li-m">{p.data.tech.slice(0, 3).join(' · ')} · {month(p.data.updated)}</span>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="qr-section" aria-labelledby="h-small">
        <h2 id="h-small">Small things</h2>
        <ul class="qr-list">
          {brief.map(p => (
            <li>
              <Fragment set:html={pixelSvg(p.data.icon, 16)} />
              <div>
                <a class="qr-li-t" href={`/projects/${p.data.slug}/`}>{p.data.title}</a>
                <span class="qr-li-d"> {p.data.oneLiner}</span>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="qr-section" aria-labelledby="h-bg">
        <h2 id="h-bg">Background</h2>
        <p>Ranked 5th nationally in Egypt in high school. Studied CS and physics at Minerva. Taught ML and AI to 250+ students at iD Tech across 20+ college campuses, three summers in a row. Before that, fine-tuned multilingual LLMs for a mental health chatbot at Findhope, deployed across 20+ Indian colleges in Hindi, Telugu, and Urdu, shipped to production in three months.</p>
        <p>What I optimize for: build the thing far enough that the hard boundary shows up; make the human hand-off explicit; prefer projects with an audit trail; write READMEs as inspection guides, not trophy cases.</p>
      </section>

      <footer class="qr-foot">
        <p>This page is the plain version of <a href="/">cuuper22.pages.dev</a>, a working retro desktop where the projects above run live, including an operating system that boots in your browser.</p>
        <p>Visits are counted without cookies or IP addresses: a per-tab random id and a country code, stored in Cloudflare D1. Global Privacy Control turns it off.</p>
      </footer>
    </main>
  </div>
  <script>
    import { trackView } from '../scripts/telemetry';
    let returning = false;
    try { returning = localStorage.getItem('cuperos.visited') === '1'; localStorage.setItem('cuperos.visited', '1'); } catch { /* ignore */ }
    trackView('read', returning);
  </script>
</Base>

<style>
  body { background: var(--c-void); }
  .qr {
    min-height: 100dvh;
    padding: 0 16px 56px;
    background:
      radial-gradient(60% 40% at 50% 0%, rgba(12, 106, 134, 0.22), transparent 70%),
      radial-gradient(circle, rgba(200, 230, 255, 0.18) 0.7px, transparent 1.2px) 0 0 / 44px 44px,
      var(--c-void);
  }
  .qr-bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    max-width: 840px;
    margin: 0 auto;
    padding: 5px 6px;
    font: 400 var(--t-11)/1 var(--f-sys);
    box-shadow: var(--bevel-raised), var(--lift);
  }
  .qr-home { display: inline-flex; align-items: center; gap: 7px; color: var(--c-ink); text-decoration: none; padding: 0 4px; font-size: var(--t-13); }
  .qr-home:visited { color: var(--c-ink); }
  .qr-crumb { color: var(--c-ink-mute); letter-spacing: var(--track-caps); text-transform: uppercase; }
  .qr-crumb::before { content: '/'; margin-right: 6px; color: var(--c-ink-faint); }
  .qr-spacer { flex: 1; }

  .qr-paper {
    max-width: 840px;
    margin: 14px auto 0;
    padding: clamp(28px, 6vw, 68px) clamp(20px, 7vw, 80px) 56px;
    background: var(--c-paper);
    box-shadow: var(--bevel-sunken), var(--lift);
    font-family: var(--f-read);
    color: var(--c-ink-soft);
    font-size: var(--t-15);
    line-height: 1.7;
  }
  .qr-kicker { font: 400 var(--t-11)/1 var(--f-sys); letter-spacing: 0.2em; text-transform: uppercase; color: var(--c-acc); }
  .qr-intro h1 { font: 400 clamp(33px, 7vw, 66px)/1 var(--f-sys); letter-spacing: -0.02em; margin: 16px 0 18px; color: var(--c-ink); }
  .qr-lede { font-size: var(--t-18); line-height: 1.6; color: var(--c-ink); max-width: 60ch; text-wrap: pretty; }
  .qr-contact { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 10px 24px; font: 400 var(--t-13)/1.3 var(--f-sys); }
  .qr-contact li { display: inline-flex; align-items: center; gap: 8px; }

  .qr-section { margin-top: 56px; }
  .qr-section h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 400 var(--t-11)/1 var(--f-sys);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-acc);
    margin-bottom: 22px;
  }
  .qr-section h2::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--c-acc-line), transparent); }
  .qr-section > p + p { margin-top: 0.9em; }
  .qr-proj { padding: 18px 0; box-shadow: inset 0 -1px var(--c-rule); }
  .qr-proj:first-of-type { padding-top: 0; }
  .qr-proj-h { display: flex; gap: 16px; align-items: flex-start; }
  .qr-proj-h svg { margin-top: 2px; filter: drop-shadow(0 2px 0 rgba(0, 0, 0, 0.6)); }
  .qr-proj h3 { font: 400 var(--t-22)/1.15 var(--f-sys); }
  .qr-proj h3 a { color: var(--c-ink); text-decoration: none; }
  .qr-proj h3 a:hover { color: var(--c-acc); }
  .qr-one { font-weight: 500; font-size: var(--t-15); line-height: 1.5; color: var(--c-ink); margin-top: 6px; text-wrap: pretty; }
  .qr-sum { margin: 12px 0 0 48px; font-size: var(--t-15); text-wrap: pretty; }
  .qr-links { margin: 10px 0 0 48px; display: flex; flex-wrap: wrap; gap: 6px 18px; font: 400 var(--t-11)/1.6 var(--f-sys); }
  .qr-tech { color: var(--c-ink-mute); width: 100%; }

  .qr-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }
  .qr-list li { display: flex; gap: 14px; align-items: flex-start; }
  .qr-list li svg { margin-top: 4px; }
  .qr-li-t { font: 400 var(--t-13)/1.4 var(--f-sys); }
  .qr-li-d { color: var(--c-ink-soft); }
  .qr-li-m { display: block; font: 400 var(--t-11)/1.7 var(--f-sys); color: var(--c-ink-mute); }

  .qr-foot { margin-top: 60px; padding-top: 18px; box-shadow: inset 0 1px var(--c-rule); font-size: var(--t-13); color: var(--c-ink-mute); }

  @media (max-width: 560px) {
    .qr-sum, .qr-links { margin-left: 0; }
    .qr-bar .btn:first-of-type { display: none; }
  }
  @media print {
    body, .qr { background: #fff; color: #111; }
    .qr { padding: 0; }
    .qr-bar { display: none; }
    .qr-paper { box-shadow: none; padding: 0; max-width: none; font-size: 10.5pt; background: #fff; color: #222; }
    .qr-intro h1, .qr-proj h3 a, .qr-one, .qr-lede { color: #000; }
    .qr-section h2, .qr-kicker { color: #000; }
    .qr-proj { break-inside: avoid; box-shadow: none; }
    a { color: inherit; text-decoration: none; }
    .qr-links a[href^="http"]::after { content: ' (' attr(href) ')'; color: #555; }
  }
</style>
